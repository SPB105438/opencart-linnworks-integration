{{header}}{{column_left}}<div id="content"><div class="container-fluid"><a href="{{back}}">Back</a><h1>Discovered Linnworks Products</h1><p>{{total}} cached items</p><table class="table"><thead><tr><th>Stock Item ID</th><th>SKU</th><th>Title</th><th>Barcode</th><th>Purchase</th><th>Retail</th><th>Quantity</th><th>Available</th><th>Discovered</th></tr></thead><tbody>{% for x in items %}<tr><td><code>{{x.stock_item_id}}</code></td><td>{{x.sku}}</td><td>{{x.item_title}}</td><td>{{x.barcode}}</td><td>{{x.purchase_price}}</td><td>{{x.retail_price}}</td><td>{{x.quantity}}</td><td>{{x.available_quantity}}</td><td>{{x.date_discovered}}</td></tr>{% else %}<tr><td colspan="9">No products discovered.</td></tr>{% endfor %}</tbody></table></div></div>{{footer}}