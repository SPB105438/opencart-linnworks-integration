{{header}}{{column_left}}<div id="content"><div class="container-fluid"><a href="{{back}}">Back</a><h1>Discovery History</h1><table class="table"><thead><tr><th>Run</th><th>Started</th><th>Completed</th><th>Status</th><th>Pages</th><th>Received</th><th>Inserted</th><th>Updated</th><th>Error</th></tr></thead><tbody>{% for x in runs %}<tr><td>#{{x.discovery_run_id}}</td><td>{{x.started_at}}</td><td>{{x.completed_at}}</td><td>{{x.status}}</td><td>{{x.pages_processed}}</td><td>{{x.items_received}}</td><td>{{x.items_inserted}}</td><td>{{x.items_updated}}</td><td>{{x.error_message}}</td></tr>{% else %}<tr><td colspan="9">No discovery runs.</td></tr>{% endfor %}</tbody></table></div></div>{{footer}}