{{ header }}{{ column_left }}<div id="content"><div class="page-header"><div class="container-fluid"><button form="form-linnworks" class="btn btn-primary float-end">Save</button><h1>{{ heading_title }}</h1></div></div><div class="container-fluid"><div id="message"></div><form id="form-linnworks" action="{{ save }}" method="post"><div class="card mb-3"><div class="card-header">Connection and configuration</div><div class="card-body"><div class="row g-3"><div class="col-md-4"><label>Application ID</label><input class="form-control" name="module_linnworks_application_id" value="{{module_linnworks_application_id}}"></div><div class="col-md-4"><label>Application Secret</label><input type="password" class="form-control" name="module_linnworks_application_secret" value="{{module_linnworks_application_secret}}"></div><div class="col-md-4"><label>Permanent Token</label><input type="password" class="form-control" name="module_linnworks_token" value="{{module_linnworks_token}}"></div><div class="col-md-8"><label>Authentication endpoint</label><input class="form-control" name="module_linnworks_auth_url" value="{{module_linnworks_auth_url}}"></div><div class="col-md-4"><label>Timeout</label><input class="form-control" type="number" name="module_linnworks_timeout" value="{{module_linnworks_timeout}}"></div><div class="col-md-6"><label>Stock Location</label><select class="form-select" name="module_linnworks_stock_location_id"><option value="">Select location</option>{% for location in stock_locations %}<option value="{{location.location_id}}" {% if module_linnworks_stock_location_id == location.location_id %}selected{% endif %}>{{location.location_name}}</option>{% endfor %}</select>{% if stock_location_missing %}<div class="alert alert-warning mt-2">The saved stock location is no longer returned by Linnworks. The setting was retained.</div>{% endif %}</div><div class="col-md-3"><label>Discovery page size</label><input class="form-control" type="number" min="1" max="200" name="module_linnworks_discovery_page_size" value="{{module_linnworks_discovery_page_size}}"></div><div class="col-md-3"><label>Maximum pages</label><input class="form-control" type="number" min="1" max="500" name="module_linnworks_discovery_max_pages" value="{{module_linnworks_discovery_max_pages}}"></div></div><input type="hidden" name="module_linnworks_discovery_stock_levels" value="1"></div></div></form><div class="mb-3"><button class="btn btn-outline-primary api" data-url="{{test}}">Test Connection</button> <button class="btn btn-outline-primary api" data-url="{{locations}}">Discover Locations</button> <button class="btn btn-outline-primary api" data-url="{{diagnostics}}">Diagnostics</button></div><div class="card mb-3"><div class="card-header">Catalogue Scanner</div><div class="card-body"><button class="btn btn-primary api" data-url="{{scan}}">Run Scan</button> <a class="btn btn-light" href="{{scanResults}}">Results</a> <a class="btn btn-light" href="{{scanHistory}}">History</a>{% if latest_scan %}<p class="mt-3">{{latest_scan.products_scanned}} products, {{latest_scan.ready_count}} ready, {{latest_scan.ean_coverage}}% EAN coverage</p>{% endif %}</div></div><div class="card"><div class="card-header">Linnworks Product Discovery</div><div class="card-body"><div class="alert alert-info">Read-only. This retrieves Linnworks catalogue information and stores a local cache. It does not change OpenCart or Linnworks products.</div><button class="btn btn-primary api" data-url="{{discoverProducts}}">Discover Linnworks Products</button> <a class="btn btn-light" href="{{discoveredProducts}}">View Products</a> <a class="btn btn-light" href="{{discoveryHistory}}">History</a> <a class="btn btn-light" href="{{exportDiscovery}}">Export CSV</a>{% if discovery_summary %}<p class="mt-3">Cached: {{discovery_summary.cached_items}}, last run: {{discovery_summary.status}}, received: {{discovery_summary.items_received}}</p>{% endif %}</div></div></div></div><div class="card mt-3">
  <div class="card-header">Product Mapping</div>
  <div class="card-body">
    <div class="alert alert-info">
      Read-only. Mapping suggestions compare the latest completed OpenCart
      catalogue scan with the current Linnworks discovery cache. No products,
      prices, inventory or orders are changed.
    </div>

    <button class="btn btn-primary api" data-url="{{ generateMappings }}">
      Generate Mapping Suggestions
    </button>
    <a class="btn btn-light" href="{{ mappingReview }}">View Mapping Review</a>
    <a class="btn btn-light" href="{{ mappingHistory }}">History</a>
    <a class="btn btn-light" href="{{ exportMappings }}">Export CSV</a>

    {% if mapping_summary %}
      <p class="mt-3">
        Last run: {{ mapping_summary.status }},
        processed: {{ mapping_summary.products_processed }},
        suggested: {{ mapping_summary.suggested_count }},
        conflicts: {{ mapping_summary.conflict_count }},
        unmatched: {{ mapping_summary.unmatched_count }}
      </p>
    {% endif %}
  </div>
</div>

<script>document.querySelectorAll('.api').forEach(b=>b.onclick=async()=>{b.disabled=true;try{let x=await fetch(b.dataset.url,{method:'POST',body:new FormData(document.getElementById('form-linnworks'))}),j=await x.json();if(j.error)throw new Error(j.error);document.getElementById('message').innerHTML='<div class="alert alert-success">'+j.success+'</div>';if(b.dataset.url.includes('scan')||b.dataset.url.includes('discoverProducts'))setTimeout(()=>location.reload(),800)}catch(e){document.getElementById('message').innerHTML='<div class="alert alert-danger">'+e.message+'</div>'}b.disabled=false});</script>{{ footer }}