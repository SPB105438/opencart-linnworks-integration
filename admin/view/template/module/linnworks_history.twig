{{header}}{{column_left}}<div id="content"><div class="page-header"><div class="container-fluid"><a href="{{back}}" class="btn btn-light float-end">Dashboard</a><h1>Scan History</h1></div></div><div class="container-fluid"><div class="card"><table class="table"><thead><tr><th>Scan</th><th>Started</th><th>Status</th><th>Products</th><th>Ready</th><th>Warnings</th><th>Critical</th><th>Health</th><th></th></tr></thead><tbody>{% for s in scans %}<tr><td>#{{s.scan_id}}</td><td>{{s.started_at}}</td><td>{{s.status}}</td><td>{{s.products_scanned}}</td><td>{{s.ready_count}}</td><td>{{s.warning_count}}</td><td>{{s.critical_count}}</td><td>{{s.health_score}}%</td><td><a href="{{results_base}}&scan_id={{s.scan_id}}">View</a></td></tr>{% endfor %}</tbody></table></div></div></div>{{footer}}