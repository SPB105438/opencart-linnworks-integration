{{ header }}{{ column_left }}<div id="content"><div class="page-header"><div class="container-fluid"><a href="{{ back }}" class="btn btn-light float-end">Dashboard</a><a href="{{ export }}" class="btn btn-success float-end me-2">Export CSV</a><h1>Catalogue Scan Results</h1></div></div><div class="container-fluid"><div class="card mb-3"><div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th>Product</th><th>Model</th><th>Normalised</th><th>Identifier</th><th>Price</th><th>Stock</th><th>Score</th><th>Ready</th></tr></thead><tbody>{% for p in products %}<tr><td>{{p.product_id}}</td><td>{{p.name}}</td><td>{{p.model}}</td><td>{{p.normalised_model}}</td><td>{{p.identifier_value ?: 'Missing'}}</td><td>{{p.price}}</td><td>{{p.quantity}}</td><td>{{p.readiness_score}}</td><td>{{p.ready_for_sync ? 'Ready':'Review'}}</td></tr>{% else %}<tr><td colspan="9">No results.</td></tr>{% endfor %}</tbody></table></div></div><div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Severity</th><th>Product</th><th>Category</th><th>Finding</th><th>Recommendation</th></tr></thead><tbody>{% for i in issues %}<tr><td>{{i.severity|title}}</td><td>#{{i.product_id}} {{i.name}}</td><td>{{i.category|title}}</td><td>{{i.description}}</td><td>{{i.recommendation}}</td></tr>{% endfor %}</tbody></table></div></div></div></div>{{footer}}