{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-linnworks" class="btn btn-primary">Save</button>
        <a href="{{ back }}" class="btn btn-light">Back</a>
      </div>
      <h1>{{ heading_title }}</h1>
    </div>
  </div>

  <div class="container-fluid">
    <div class="alert alert-warning">
      v0.2.5-test commissioning build. Live product, price, stock, order and fulfilment writes are disabled.
    </div>

    <form id="form-linnworks" action="{{ save }}" method="post">
      <div class="card mb-4">
        <div class="card-header">Linnworks API Connection</div>
        <div class="card-body">
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Application ID</label>
            <div class="col-sm-9"><input name="module_linnworks_application_id" value="{{ module_linnworks_application_id }}" class="form-control"></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Application Secret</label>
            <div class="col-sm-9"><input type="password" name="module_linnworks_application_secret" value="{{ module_linnworks_application_secret }}" class="form-control"></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Permanent Token</label>
            <div class="col-sm-9"><input type="password" name="module_linnworks_token" value="{{ module_linnworks_token }}" class="form-control"></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Authentication endpoint</label>
            <div class="col-sm-9"><input name="module_linnworks_auth_url" value="{{ module_linnworks_auth_url }}" class="form-control"></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Timeout</label>
            <div class="col-sm-3"><input type="number" name="module_linnworks_timeout" value="{{ module_linnworks_timeout }}" class="form-control"></div>
          </div>
          <div class="d-flex gap-3 flex-wrap">
            <button id="lw-test" type="button" class="btn btn-primary">Test Connection</button>
            <button id="lw-locations" type="button" class="btn btn-outline-primary">Discover Locations</button>
            <button id="lw-diagnostics" type="button" class="btn btn-outline-secondary">Run Diagnostics</button>
            <button id="lw-scan" type="button" class="btn btn-outline-secondary">Scan Catalogue</button>
          </div>
          <div id="lw-result" class="mt-3"></div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header">Channel Integration</div>
        <div class="card-body">
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Channel Name</label>
            <div class="col-sm-9"><input name="module_linnworks_channel_name" value="{{ module_linnworks_channel_name }}" class="form-control"></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Friendly Name</label>
            <div class="col-sm-9"><input name="module_linnworks_channel_friendly_name" value="{{ module_linnworks_channel_friendly_name }}" class="form-control"></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Public Base URL</label>
            <div class="col-sm-9"><input name="module_linnworks_public_base_url" value="{{ module_linnworks_public_base_url }}" class="form-control"></div>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header">Pricing and Inventory</div>
        <div class="card-body">
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Price authority</label>
            <div class="col-sm-9">
              <select name="module_linnworks_price_authority" class="form-select">
                <option value="opencart">OpenCart</option>
                <option value="linnworks">Linnworks</option>
                <option value="manual">Manual review</option>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Linnworks price field</label>
            <div class="col-sm-9">
              <select name="module_linnworks_price_field" class="form-select">
                <option value="purchase_price">Purchase Price</option>
                <option value="retail_price">Retail Price</option>
              </select>
            </div>
          </div>
          <p class="text-muted">OpenCart exports the net base price. VAT remains controlled by OpenCart Tax Classes.</p>
        </div>
      </div>

      <input type="hidden" name="module_linnworks_status" value="1">
      <input type="hidden" name="module_linnworks_dry_run" value="1">
    </form>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var form = document.getElementById('form-linnworks');
  var result = document.getElementById('lw-result');

  function run(url) {
    result.innerHTML = '<div class="alert alert-info">Working...</div>';
    fetch(url, {method: 'POST', body: new FormData(form), credentials: 'same-origin'})
      .then(function (response) {
        return response.text().then(function (text) {
          if (!response.ok) {
            throw new Error('HTTP ' + response.status + ': ' + text);
          }
          try {
            return JSON.parse(text);
          } catch (error) {
            throw new Error('Invalid JSON response: ' + text.substring(0, 500));
          }
        });
      })
      .then(function (data) {
        result.innerHTML = '<pre class="alert"></pre>';
        var pre = result.querySelector('pre');
        pre.classList.add(data.error ? 'alert-danger' : 'alert-success');
        pre.textContent = JSON.stringify(data, null, 2);
      })
      .catch(function (error) {
        result.innerHTML = '<div class="alert alert-danger"></div>';
        result.firstChild.textContent = error.message;
      });
  }

  document.getElementById('lw-test').addEventListener('click', function () { run('{{ test }}'); });
  document.getElementById('lw-locations').addEventListener('click', function () { run('{{ locations_url }}'); });
  document.getElementById('lw-diagnostics').addEventListener('click', function () { run('{{ diagnostics }}'); });
  document.getElementById('lw-scan').addEventListener('click', function () { run('{{ scan }}'); });
});
</script>
{{ footer }}
