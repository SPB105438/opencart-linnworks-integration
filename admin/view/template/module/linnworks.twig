{{ header }}{{ column_left }}<div id="content"><div class="page-header"><div class="container-fluid"><div class="float-end"><button form="form-lw" class="btn btn-primary">Save</button> <a href="{{ back }}" class="btn btn-light">Back</a></div><h1>{{ heading_title }}</h1></div></div><div class="container-fluid">{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}<style>.lw-hero{background:linear-gradient(120deg,#15243e,#1f3a66);color:#fff;border-radius:18px;padding:24px}.lw-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin:18px 0}.lw-card{background:#fff;border:1px solid #e5eaf2;border-radius:14px;padding:17px}.lw-value{font-size:28px;font-weight:800}.nav-tabs{margin:18px 0}.tab-pane{padding-top:10px}@media(max-width:1000px){.lw-grid{grid-template-columns:repeat(2,1fr)}}</style><div class="lw-hero"><h2>Linnworks Integration v0.3.1-dev</h2><p>API configuration restored and combined with the read-only catalogue scanner.</p><div id="msg"></div></div><ul class="nav nav-tabs"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview">Overview</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#connection">Connection</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#matching">Products & Matching</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#inventory">Inventory & Pricing</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#orders">Orders</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#scanner">Catalogue Scanner</button></li></ul><form id="form-lw" action="{{ save }}" method="post"><div class="tab-content"><div id="overview" class="tab-pane fade show active"><div class="lw-grid"><a href="{{ results }}"><div class="lw-card"><small>Products analysed</small><div class="lw-value">{{ dashboard.products_scanned|default(0) }}</div></div></a><a href="{{ results }}&ready=1"><div class="lw-card"><small>Ready</small><div class="lw-value text-success">{{ dashboard.ready_count|default(0) }}</div></div></a><a href="{{ results }}&severity=warning"><div class="lw-card"><small>Warnings</small><div class="lw-value text-warning">{{ dashboard.warning_count|default(0) }}</div></div></a><a href="{{ results }}&severity=critical"><div class="lw-card"><small>Critical</small><div class="lw-value text-danger">{{ dashboard.critical_count|default(0) }}</div></div></a><a href="{{ results }}&category=identifier"><div class="lw-card"><small>EAN coverage</small><div class="lw-value">{{ dashboard.identifier_coverage|default(0) }}%</div></div></a></div><button type="button" class="btn btn-outline-primary api" data-url="{{ test }}">Test connection</button> <button type="button" class="btn btn-outline-primary api" data-url="{{ diagnostics }}">Run diagnostics</button> <button type="button" class="btn btn-primary api" data-url="{{ scan }}">Run catalogue scan</button></div><div id="connection" class="tab-pane fade"><div class="card"><div class="card-header"><strong>Linnworks API Connection</strong></div><div class="card-body row g-3"><div class="col-md-6"><label>Application ID</label><input class="form-control" name="module_linnworks_application_id" value="{{ module_linnworks_application_id }}"></div><div class="col-md-6"><label>Application Secret</label><input type="password" class="form-control" name="module_linnworks_application_secret" value="{{ module_linnworks_application_secret }}"></div><div class="col-md-6"><label>Permanent Token</label><input type="password" class="form-control" name="module_linnworks_token" value="{{ module_linnworks_token }}"></div><div class="col-md-4"><label>Authentication endpoint</label><input class="form-control" name="module_linnworks_auth_url" value="{{ module_linnworks_auth_url }}"></div><div class="col-md-2"><label>Timeout</label><input type="number" class="form-control" name="module_linnworks_timeout" value="{{ module_linnworks_timeout }}"></div><div class="col-12"><button type="button" class="btn btn-primary api" data-url="{{ test }}">Test Connection</button> <button type="button" class="btn btn-secondary api" data-url="{{ locations }}">Discover Locations</button> <button type="button" class="btn btn-secondary api" data-url="{{ diagnostics }}">Run Diagnostics</button></div></div></div><div class="card mt-3"><div class="card-header"><strong>Channel metadata</strong></div><div class="card-body row g-3"><div class="col-md-6"><label>Channel Name</label><input class="form-control" name="module_linnworks_channel_name" value="{{ module_linnworks_channel_name }}"></div><div class="col-md-6"><label>Friendly Name</label><input class="form-control" name="module_linnworks_channel_friendly_name" value="{{ module_linnworks_channel_friendly_name }}"></div><div class="col-md-6"><label>Source</label><input class="form-control" name="module_linnworks_source" value="{{ module_linnworks_source }}"></div><div class="col-md-6"><label>SubSource</label><input class="form-control" name="module_linnworks_sub_source" value="{{ module_linnworks_sub_source }}"></div></div></div></div><div id="matching" class="tab-pane fade"><div class="card"><div class="card-body"><label>Primary product-code identifier</label><select class="form-select" name="module_linnworks_identifier_code">{% for c in code_types %}<option value="{{ c.code }}"{% if c.code==module_linnworks_identifier_code %} selected{% endif %}>{{ c.code }} ({{ c.total }})</option>{% else %}<option>EAN</option>{% endfor %}</select><label class="mt-3">Model normalisation</label><select class="form-select" name="module_linnworks_model_normalisation"><option value="optional_n_prefix">Trim, uppercase, remove separators and optional N prefix</option></select><label class="mt-3">Readiness target</label><input type="number" class="form-control" name="module_linnworks_readiness_target" value="{{ module_linnworks_readiness_target }}"></div></div></div><div id="inventory" class="tab-pane fade"><div class="card"><div class="card-body row g-3"><div class="col-md-6"><label>Stock Location</label><select class="form-select" name="module_linnworks_stock_location_id"><option value="">Select location</option>{% for loc in stock_locations %}<option value="{{ loc.StockLocationId|default(loc.pkStockLocationId|default('')) }}"{% if module_linnworks_stock_location_id==loc.StockLocationId|default(loc.pkStockLocationId|default('')) %} selected{% endif %}>{{ loc.LocationName|default(loc.StockLocationName|default('Location')) }}</option>{% endfor %}</select></div><div class="col-md-3"><label>Price authority</label><select class="form-select" name="module_linnworks_price_authority"><option value="opencart">OpenCart</option><option value="linnworks">Linnworks</option><option value="manual">Manual review</option></select></div><div class="col-md-3"><label>Linnworks price field</label><select class="form-select" name="module_linnworks_price_field"><option value="purchase_price">Purchase Price</option><option value="retail_price">Retail Price</option></select></div></div></div></div><div id="orders" class="tab-pane fade"><div class="alert alert-info">Configuration only in this release. Order export remains disabled.</div><div class="row g-3"><div class="col-md-6"><label>OpenCart export status ID</label><input type="number" class="form-control" name="module_linnworks_export_status_id" value="{{ module_linnworks_export_status_id }}" placeholder="Pending status ID"></div><div class="col-md-6"><label>OpenCart completion status ID</label><input type="number" class="form-control" name="module_linnworks_complete_status_id" value="{{ module_linnworks_complete_status_id }}" placeholder="Complete status ID"></div></div></div><div id="scanner" class="tab-pane fade"><button type="button" class="btn btn-primary api" data-url="{{ scan }}">Run catalogue scan</button> <a class="btn btn-light" href="{{ results }}">View results</a> <a class="btn btn-light" href="{{ history }}">History</a><div class="card mt-3"><div class="card-header">Issues requiring attention</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Severity</th><th>Product</th><th>Finding</th><th>Recommendation</th></tr></thead><tbody>{% for i in issues %}<tr><td>{{ i.severity|title }}</td><td>#{{ i.product_id }} {{ i.name }}</td><td>{{ i.description }}</td><td>{{ i.recommendation }}</td></tr>{% else %}<tr><td colspan="4">Run a scan to populate results.</td></tr>{% endfor %}</tbody></table></div></div></div></div><input type="hidden" name="module_linnworks_status" value="1"><input type="hidden" name="module_linnworks_dry_run" value="1"></form></div></div><script>document.querySelectorAll('.api').forEach(b=>b.addEventListener('click',async()=>{let fd=new FormData(document.getElementById('form-lw'));b.disabled=true;document.getElementById('msg').innerHTML='Working...';try{let r=await fetch(b.dataset.url,{method:'POST',body:fd}),j=await r.json();if(j.error)throw new Error(j.error);document.getElementById('msg').innerHTML='<div class="alert alert-success mt-3">'+j.success+'</div>';if(b.dataset.url.includes('scan'))setTimeout(()=>location.reload(),600);}catch(e){document.getElementById('msg').innerHTML='<div class="alert alert-danger mt-3">'+e.message+'</div>';}b.disabled=false;}));</script>{{ footer }}